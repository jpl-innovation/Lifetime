#!/bin/sh
# Lifetime AppImage entry point. With no arguments it opens Lifetime. "--run-tool NAME" starts another program of the
# bundle (LifetimeTracker, LifetimeImport, LifetimeAgent, LifetimeServerDashboard); Lifetime itself uses this form for
# autostart entries and background processes, because the AppImage's mount path changes every time it starts.
# A start without arguments is marked: on a computer with Lifetime Server installed, Lifetime then asks whether to open
# the server dashboard instead ("--run-tool Lifetime" always opens Lifetime).
here="$(dirname "$(readlink -f "$0")")"
tool=Lifetime
if [ $# -eq 0 ]; then
    LIFETIME_APPIMAGE_START=1
    export LIFETIME_APPIMAGE_START
elif [ "${1:-}" = "--run-tool" ]; then
    case "${2:-}" in
        Lifetime|LifetimeTracker|LifetimeImport|LifetimeAgent|LifetimeServerDashboard) tool="$2"; shift 2 ;;
        *) echo "Unknown Lifetime program: ${2:-}" >&2; exit 2 ;;
    esac
fi
exec "$here/usr/lib/lifetime/$tool" "$@"
